# Confirmed mode: bundled PostgreSQL, combined React/Go application.
COMPOSE_PROJECT_NAME=datamesh-production
DB_MODE=bundled
WEB_MODE=combined
BASE_PATH=/datamesh
APP_ORIGIN=https://tbtparent.me
APP_PORT=31010
# Fill the actual Docker bridge gateway used by host Nginx before launching app.
TRUSTED_PROXY_IPS=["127.0.0.1"]
# Fill exact verified digests from this release's manifest, never latest.
APP_IMAGE=
POSTGRES_IMAGE=
RUSTFS_IMAGE=
DORIS_FE_IMAGE=
DORIS_BE_IMAGE=
FLINK_IMAGE=
KAFKA_IMAGE=
CONNECT_IMAGE=
SOURCE_READER_IMAGE=
# Registry references are pulled before starting the runner. IMAGE values below
# are the corresponding immutable image configuration IDs, not registry digests.
CODE_PYTHON_REF=
CODE_JAVASCRIPT_REF=
CODE_PYTHON_IMAGE=
CODE_JAVASCRIPT_IMAGE=
# Application and migration receive only their respective connection.
DATABASE_URL=
MIGRATION_DATABASE_URL=
CSRF_KEY=
CREDENTIAL_KEY=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
DORIS_ROOT_PASSWORD=
DORIS_WRITER_PASSWORD=
DORIS_READER_PASSWORD=
SANDBOX_DORIS_READER_PASSWORD=
SANDBOX_DORIS_WRITER_PASSWORD=
SOURCE_READER_TOKEN=
SOURCE_DB_PASSWORD=
SOURCE_CDC_PASSWORD=
SECURITY_WATERMARK_KEY_ID=
SECURITY_WATERMARK_KEYS=
PUBLIC_TEST_ACCOUNTS_FILE=
SOURCE_ALLOWED_TARGETS=[]
API_ALLOWED_TARGETS=[]
# Private file paths only. Generate secret contents separately; never source this file.
BOOTSTRAP_ADMIN_FILE=./secrets/bootstrap-admin.json
DOCKER_SOCKET_GID=
DORIS_SUBNET=172.30.238.0/24
DORIS_FE_IP=172.30.238.10
DORIS_BE_IP=172.30.238.11
