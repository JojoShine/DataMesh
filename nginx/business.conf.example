# Include only in the existing tbtparent.me HTTPS server.
# Configuration and the trusted internal certificate belong to this release.
location = /datamesh {
    return 308 /datamesh/$is_args$args;
}
location ^~ /datamesh/internal/ {
    return 404;
}
location ^~ /datamesh/ {
    proxy_pass https://127.0.0.1:31010;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name localhost;
    proxy_ssl_trusted_certificate /opt/datamesh/secrets/tls/server.crt;
    proxy_ssl_verify on;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;
    client_max_body_size 65m;
}
