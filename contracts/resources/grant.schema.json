{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:datamesh:grant:v1",
  "additionalProperties": false,
  "required": [
    "resource",
    "department_id",
    "purpose",
    "fields",
    "expires_at"
  ],
  "properties": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id",
        "contract_version"
      ],
      "properties": {
        "resource_type": {
          "enum": [
            "raw_object",
            "governed_dataset",
            "table_resource",
            "file_resource",
            "api_resource"
          ]
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "department_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "fields": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_basis",
        "scenario",
        "scope",
        "method",
        "department_approval_ref"
      ],
      "properties": {
        "legal_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scenario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "method": {
          "enum": [
            "query",
            "download",
            "invoke"
          ]
        },
        "department_approval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resource": {
            "properties": {
              "resource_type": {
                "const": "file_resource"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "fields": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
